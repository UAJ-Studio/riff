# Riff wireless pack: backports Kconfig (CPTCFG_ = backported CONFIG_).
# regulatory.db stays signature-checked; the pack ships regulatory.db.p7s.
CPTCFG_CFG80211=m
CPTCFG_CFG80211_WEXT=y
# CPTCFG_CFG80211_CRDA_SUPPORT is not set
# CPTCFG_CFG80211_DEFAULT_PS is not set
CPTCFG_MAC80211=m
CPTCFG_MAC80211_LEDS=y
CPTCFG_MAC80211_MESH=y
CPTCFG_MAC80211_RC_MINSTREL=y
CPTCFG_WLAN=y
CPTCFG_WLAN_VENDOR_REALTEK=y
